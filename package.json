{
  "name": "specform-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\u0424\u043e\u0442\u043e \u0438\u0437\u0434\u0435\u043b\u0438\u044f \u2192 StyleSpec \u2192 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0442\u0435\u0445\u043f\u0430\u043a \u0434\u043b\u044f \u0444\u0430\u0431\u0440\u0438\u043a\u0438 \u0420\u0424",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kb:validate": "tsx packages/kb/scripts/validate.ts",
    "stylespec:schema": "tsx packages/stylespec/scripts/emit-json-schema.ts",
    "golden": "vitest run --project golden",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "stylespec:examples": "tsx packages/stylespec/scripts/generate-examples.ts",
    "vision:analyze": "tsx --env-file-if-exists=.env packages/vision/scripts/analyze.ts",
    "flats:preview": "tsx packages/flats/scripts/preview.ts",
    "generate": "tsx --env-file-if-exists=.env apps/cli/src/main.ts",
    "pattern": "tsx --env-file-if-exists=.env apps/cli/src/pattern.ts",
    "rfq": "tsx apps/cli/src/rfq.ts",
    "rfq:report": "tsx apps/cli/src/rfq-report.ts",
    "golden:export": "tsx golden/scripts/export-vision-reports.ts",
    "golden:warm": "tsx --env-file-if-exists=.env golden/scripts/warm-vision.ts",
    "golden:renders": "tsx golden/scripts/export-renders.ts",
    "golden:backviews": "tsx --env-file-if-exists=.env golden/scripts/backviews.ts",
    "fit:form": "tsx apps/cli/src/form.ts",
    "fit:score": "tsx apps/cli/src/score.ts",
    "fit:demo": "tsx golden/scripts/demo-score.ts | xargs -I{} tsx apps/cli/src/score.ts {}"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
