# Claude API. Ключ нужен только vision-этапу; справочники, сборка спеки,
# рендеры чертежа и документа работают без него.
ANTHROPIC_API_KEY=

# Модель vision-анализа. Фаза 0 — Opus 5: RAT-1 про точность, экономить на ней рано.
# Переключение на Sonnet 5 — по данным голден-сета, не по ощущениям.
SPECFORM_VISION_MODEL=claude-opus-5

# Каталог контент-адресуемого кэша vision (ADR-0003).
# Один и тот же вход обязан давать один и тот же VisionReport.
SPECFORM_CACHE_DIR=.cache/vision

LOG_LEVEL=info
