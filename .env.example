# Claude API. Ключ нужен только vision-этапу; справочники, сборка спеки,
# рендеры чертежа и документа работают без него.
ANTHROPIC_API_KEY=

# Модель vision-анализа. Фаза 0 — Opus 5: RAT-1 про точность, экономить на ней рано.
# Переключение на Sonnet 5 — по данным голден-сета, не по ощущениям.
SEAMSTERLY_VISION_MODEL=claude-opus-5

# Каталог контент-адресуемого кэша vision (ADR-0003).
# Один и тот же вход обязан давать один и тот же VisionReport.
SEAMSTERLY_CACHE_DIR=.cache/vision

LOG_LEVEL=info

# Цепочка моделей визуализации. Первая — основная, остальные подхватывают
# её отказы: генератор изображений регулярно блокирует по safety безобидную
# одежду, и через OpenAI-совместимый проход это выглядит как ответ 200
# без картинки. Знание снято с боевого бэкенда виджета примерки.
SEAMSTERLY_IMAGE_MODELS=gemini-3-pro-image,gemini-3.1-flash-image-preview,gemini-2.5-flash-image
